# Set only in Vercel environment variables. Never commit real tokens.
NUXT_MERCADO_PAGO_ACCESS_TOKEN=
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_GOOGLE_REFRESH_TOKEN=
NUXT_GOOGLE_CALENDAR_ID=primary
NUXT_BOOKING_SECRET=
NUXT_PUBLIC_SITE_URL=https://oscarbahamonde.com

# Persistent Postgres. Run npm run db:migrate before enabling chat.
NUXT_DATABASE_URL=
NUXT_DATABASE_SSL=require
# At least 32 random bytes; separate from BOOKING_SECRET.
NUXT_CHAT_SESSION_SECRET=
NUXT_CHAT_IDLE_MINUTES=15
NUXT_CHAT_RETENTION_DAYS=90
NUXT_CHAT_MAX_FILE_BYTES=3000000
NUXT_CHAT_MAX_FILES=5
NUXT_CHAT_ALLOWED_MIME=application/pdf,image/png,image/jpeg,image/webp,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document,audio/webm,audio/ogg,audio/mp4

# OpenAI-compatible provider supporting streaming and JSON response format.
NUXT_LLM_BASE_URL=https://api.openai.com/v1
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=
NUXT_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
NUXT_TRANSCRIPTION_API_KEY=
NUXT_TRANSCRIPTION_MODEL=whisper-1

# Turnstile widget for this hostname, action=lead-chat.
NUXT_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
NUXT_TURNSTILE_HOSTNAME=oscarbahamonde.com

# Private S3/R2 bucket; credentials limited to leads/*.
NUXT_STORAGE_ENDPOINT=
NUXT_STORAGE_REGION=auto
NUXT_STORAGE_BUCKET=
NUXT_STORAGE_ACCESS_KEY_ID=
NUXT_STORAGE_SECRET_ACCESS_KEY=

# Choose Gmail API (gmail.send scope) OR SMTP with Gmail app password.
# Do not reuse the Calendar refresh token for Gmail.
NUXT_GMAIL_CLIENT_ID=
NUXT_GMAIL_CLIENT_SECRET=
NUXT_GMAIL_REFRESH_TOKEN=
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_LEAD_NOTIFICATION_TO=oscar.bahamonde.dev@gmail.com

# >=32 random bytes. Scheduler: GET /api/chat/cron every 5min, Bearer auth.
NUXT_CRON_SECRET=

# AWS assistant (set NUXT_PUBLIC_ASSISTANT_URL only after deploying and testing Lambda).
NUXT_PUBLIC_ASSISTANT_URL=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_PUBLIC_ASSISTANT_MAX_BYTES=5000000
NUXT_PUBLIC_ASSISTANT_RETENTION_DAYS=90
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_MODEL_ARN=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=3
UPLOAD_BUCKET=
SESSIONS_TABLE=
MESSAGES_TABLE=
LEADS_TABLE=
OWNER_EMAIL=oscar.bahamonde.dev@gmail.com
LEADS_DLQ_URL=
KMS_KEY_ARN=
GOOGLE_SECRET_ARN=
TURNSTILE_SECRET_ARN=
TURNSTILE_SITE_KEY=
RETENTION_DAYS=90
MAX_FILE_BYTES=5000000
MAX_FILES=5
MAX_TOKENS=2000
MODEL_TEMPERATURE=0.5
BEDROCK_PROMPT_CACHE=true
MAX_TURNS=60
MAX_SESSION_TOKENS=120000
CALENDAR_BUFFER_MINUTES=15
FREE_INTRO_CALL_ENABLED=false
MONTHLY_BUDGET_USD=10
# Google values go inside Secrets Manager JSON; never expose through NUXT_PUBLIC_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
MERCADOPAGO_ACCESS_TOKEN=
TURNSTILE_SECRET_KEY=

# Optional until configured in MercadoPago + Vercel; once set, invalid/missing webhook signatures fail.
# API payment lookup and approved/PEN20/live-mode/order checks remain mandatory either way.
NUXT_MERCADO_PAGO_WEBHOOK_SECRET=
