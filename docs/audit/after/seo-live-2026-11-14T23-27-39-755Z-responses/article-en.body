24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-icon"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></a></div><div class="header-actions"><button class="icon-button language-button" aria-label="Change language · EN"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-languages-icon"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg><span>EN</span></button><button class="icon-button theme-button" aria-label="Change theme"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun-icon sun-icon"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon-icon moon-icon"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></button></div></nav></header><!--]--><main id="content" class="shell section blog-detail" data-v-bc27c3f1><a href="/en#blog" class="text-link" data-v-bc27c3f1>← Blog</a><p class="eyebrow" data-v-bc27c3f1>An excerpt from the original article · Medium · ES</p><h1 lang="es" data-v-bc27c3f1>Quipubase: Una base de datos semántica inspirada en el quipu andino</h1><div class="article-meta" data-v-bc27c3f1><time datetime="2025-08-04T08:33:37.000Z" data-v-bc27c3f1>August 4, 2025</time><span data-v-bc27c3f1>3 min</span></div><!----><p lang="es" data-v-bc27c3f1>“El futuro de los datos puede aprender del pasado.” Vivimos en una era donde los datos están en todas partes: APIs, bases vectoriales, LLMs, flujos JSON, modelos multimodales… pero ¿y si pensáramos nuestras estructuras de datos como redes vivas, narrativas, jerárquicas y culturalmente conscientes? De esa intuición nace Quipubase , una plataforma documental y semántica…</p><div class="article-tags" data-v-bc27c3f1><!--[--><span data-v-bc27c3f1>openai</span><span data-v-bc27c3f1>ai</span><span data-v-bc27c3f1>database</span><!--]--></div><a href="https://medium.com/@obahamonde/quipubase-una-base-de-datos-sem%C3%A1ntica-inspirada-en-el-quipu-andino-5a4fecfd18c7" class="button primary" data-v-bc27c3f1>Read on Medium ↗</a></main><footer class="footer shell" data-v-bc27c3f1><div><span class="footer-name">Oscar Bahamonde<span class="accent-dot">.</span></span><p>Purposeful software. Thoughtful engineering.</p></div><div class="footer-bottom"><small>© 2026 Oscar Bahamonde · Peru</small><a href="/en/privacy" class="">Privacy</a><a href="https://medium.com/@obahamonde">Medium ↗</a><a href="mailto:oscar.bahamonde.dev@gmail.com">Email ↗</a></div></footer><nav class="dock-wrap" aria-label="Explore the portfolio" data-v-bc27c3f1><ul class="dock"><!--[--><li class="dock-item" style="--magnify:1;"><a href="/en#home" class="dock-link dock-home" aria-label="Home"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.58